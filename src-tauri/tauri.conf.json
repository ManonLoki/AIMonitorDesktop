{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMonitorDesktop",
  "mainBinaryName": "AIMonitorDesktop",
  "version": "1.1.0",
  "identifier": "com.manonloki.aimonitordesktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AIMonitorDesktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "maximized": false,
        "visible": false
      },
      {
        "label": "pet",
        "title": "AIMonitorDesktop 桌宠",
        "url": "index.html?view=pet",
        "width": 480,
        "height": 480,
        "minWidth": 160,
        "minHeight": 160,
        "maxWidth": 720,
        "maxHeight": 720,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ManonLoki",
    "copyright": "Copyright © 2026 ManonLoki. All rights reserved.",
    "category": "Utility",
    "shortDescription": "AI 监控平台桌面客户端",
    "longDescription": "AIMonitorDesktop 是用于集中展示与管理局域网 AI 任务状态的桌面监控客户端。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
